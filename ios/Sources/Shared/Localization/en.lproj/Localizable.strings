/* Help */
"help.title" = "Help";
"help.start.title" = "Getting started";
"help.start.1" = "TVBox Remote controls an Android TV or Google TV box over Wi-Fi.";
"help.start.2" = "1. Connect your iPhone to the same Wi-Fi network as the TV box.";
"help.start.3" = "2. Open the menu (three dots) and tap Devices. The app shows the boxes that it finds.";
"help.start.4" = "3. Tap your box. The first time, the app pairs with the box.";
"help.start.5" = "When the dot next to the box name is green, the remote is ready. The app connects to the same box again the next time you open it.";
"help.pairing.title" = "Pairing with Wi-Fi";
"help.pairing.1" = "When you pair, the TV shows a code of 6 characters, for example 4A7F2C. Type the code on the iPhone and tap Pair.";
"help.pairing.2" = "The code uses the numbers 0 to 9 and the letters A to F. If the app says that the code is wrong, look at the TV again and type the code again.";
"help.pairing.3" = "You pair only one time. The box remembers this iPhone. If you reset the box, open Devices, swipe left on the box, tap Forget, and pair again.";
"help.pairing.4" = "If the box does not show in Devices, tap Add by IP address. On the box, the IP address is in Settings > Network & Internet.";
"help.buttons.title" = "Buttons";
"help.buttons.1" = "The D-pad moves the focus on the TV. OK selects. Hold an arrow or a volume button to repeat it.";
"help.buttons.2" = "Power turns the box on and off. Back, Home, and Settings work like the buttons of the original remote.";
"help.buttons.3" = "Other keys, such as Play/Pause, Rewind, and Input, are in the menu under Media keys. The light on the right edge shows each command that goes to the box.";
"help.mouse.title" = "Mouse and receiver";
"help.mouse.1" = "The mouse moves a cursor on the TV. Tap the Mouse button on the main screen.";
"help.mouse.2" = "The Android TV protocol has no mouse. To use the mouse, install the TVBox Remote Receiver app on the box, open it one time, and turn on its accessibility service when the app asks.";
"help.mouse.3" = "The first time, the TV shows a 4-digit code. Type it on the iPhone.";
"help.mouse.4" = "With Gyro on, point the iPhone at the TV with the screen up. Turn the phone left or right to move the cursor sideways. Tilt it up or down to move the cursor up or down.";
"help.mouse.5" = "You can also drag one finger on the touch pad. Tap to click. Hold to long press. Drag two fingers to scroll.";
"help.mouse.6" = "An iPhone cannot act as a Bluetooth mouse or remote, because iOS does not allow it. The mouse works only over Wi-Fi with the receiver app.";
"help.controller.title" = "Controller mode";
"help.controller.1" = "Tap the Controller button on the main screen. The screen turns to landscape and shows a game controller with two sticks, a D-pad, A, B, X, Y, Start, Select, and the shoulder buttons.";
"help.controller.2" = "Over Wi-Fi, the buttons send game controller keys, and the left stick works as a D-pad.";
"help.controller.3" = "The right stick moves the mouse cursor. It needs the TVBox Remote Receiver app on the box, paired one time on the Mouse screen.";
"help.controller.4" = "To move the controls or change their size, open Preferences and tap Controller layout. Tap Exit at the top to go back to the remote.";
"help.widget.title" = "Home Screen widget";
"help.widget.1" = "On iOS 17 and later, add the TVBox Remote widget to the Home Screen. It is a small remote with a D-pad, Power, Back, and Home.";
"help.widget.2" = "A press sends the key to the box without opening the app. The first press can take about one second, because the widget connects first.";
"help.widget.3" = "To choose the box, touch and hold the widget and tap Edit Widget. If you have more than one box, the small arrows button in the widget shows the next box.";
"help.keyboard.title" = "Keyboard";
"help.keyboard.1" = "Select a text field on the TV, for example a search field. Then tap the Keyboard button.";
"help.keyboard.2" = "The text appears on the TV while you type. The Send key presses Enter on the box. Delete removes the last character.";
"help.keyboard.3" = "When the box opens its own on-screen keyboard, the app can open the keyboard for you.";
"help.trouble.title" = "Troubleshooting";
"help.trouble.1" = "No boxes in Devices: make sure that the iPhone and the box are on the same Wi-Fi network. In iPhone Settings > Privacy & Security > Local Network, make sure that TVBox Remote is on.";
"help.trouble.2" = "Some Wi-Fi networks, such as guest networks, block devices from seeing each other. Use your home network or add the box by IP address.";
"help.trouble.3" = "The connection fails after it worked before: the box can have a new IP address. Wait until the box shows in Devices again, or tap it there.";
"help.trouble.4" = "\"The certificate of the box changed\": the box was reset or replaced. Forget the box in Devices and pair again.";
"help.trouble.5" = "The mouse does not work: on the box, open TVBox Remote Receiver and make sure that its accessibility service is on.";
"help.trouble.6" = "Power does not turn the box on: some boxes turn off their network in standby. Use the original remote to turn the box on, or turn on a network standby option on the box.";

/* About */
"about.title" = "About";
"about.version %@ %@" = "Version %@ (%@)";
"about.description" = "A simple remote control for Android TV and Google TV boxes.";
"about.protocols.title" = "Protocols";
"about.protocols.1" = "Android TV Remote protocol, version 2: the same protocol as the Google TV remote app. The app uses it for the buttons, the volume, power, the keyboard, and Controller mode. The connection uses TLS with a certificate that the app makes on this iPhone.";
"about.protocols.2" = "TVBox Remote Receiver protocol: a small protocol for the mouse. It works with the TVBox Remote Receiver app on the box.";
"about.protocols.3" = "Bonjour: the app uses it to find boxes and receivers on your Wi-Fi network.";
"about.privacy.title" = "Privacy";
"about.privacy.1" = "The app talks only to devices on your local network. It collects no data.";
"about.privacy.2" = "The pairing data stays on this iPhone, in the keychain and in the app settings.";
"about.credits.title" = "Credits";
"about.credits.1" = "The description of the Android TV Remote protocol comes from the research of the open-source androidtvremote2 project.";
"about.credits.2" = "Android, Android TV, and Google TV are trademarks of Google LLC. This app is not made or endorsed by Google.";

