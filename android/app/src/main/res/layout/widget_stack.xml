<?xml version="1.0" encoding="utf-8"?>
<!-- The card stack: one card per saved device. Swipe up or down for the next card. Android 12 and later.
     The app button is on this frame, because a card can only send the stack's one intent template. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <StackView
        android:id="@+id/w_stack"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:loopViews="true" />

    <ImageView
        android:id="@+id/w_stack_open"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:contentDescription="@string/widget_open_app"
        android:padding="6dp"
        android:src="@drawable/ic_w_open" />
</FrameLayout>
