<?xml version="1.0" encoding="utf-8"?>
<!-- A raised round button. Pressed, the gradient flips (docs/UI_SPEC.md, "Raised buttons"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:endColor="#22252D" android:startColor="#17191E" />
            <stroke android:width="1dp" android:color="#664F8CFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:endColor="#17191E" android:startColor="#272A33" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
