<?xml version="1.0" encoding="utf-8"?>
<!-- The OK button: an accent gradient that flips while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient android:angle="270" android:endColor="#5C93F5" android:startColor="#3468D6" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:endColor="#3A74E8" android:startColor="#6FA2FF" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</selector>
