<?xml version="1.0" encoding="utf-8"?>
<!-- The widget body: the remote screen gradient (docs/UI_SPEC.md, "Background texture") with a thin rim. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:endColor="#0A0B0E"
        android:startColor="#16181D" />
    <stroke
        android:width="1dp"
        android:color="#1FFFFFFF" />
</shape>
