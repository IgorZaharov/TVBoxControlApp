<?xml version="1.0" encoding="utf-8"?>
<!-- The compact home screen remote: 4 x 2 cells, the D-pad on the left and the other buttons on the right. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description_compact"
    android:initialLayout="@layout/widget_empty"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="100dp"
    android:previewLayout="@layout/widget_card_compact"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
